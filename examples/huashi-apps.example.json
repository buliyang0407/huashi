                    "type": "textarea",
                    "label": "\u63d0\u793a\u8bcd",
                    "required": true,
                    "defaultValue": "\u7a7f\u6234\n\u8fd9\u4f4d\u7531\u52a8\u6f2b Coser \u626e\u6f14\u7684\u6566\u714c\u795e\u5973\uff0c\u68b3\u7740\u53cc\u73af\u9ad8\u9afb\uff0c\u53d1\u9afb\u4e0a\u70b9\u7f00\u7740\u7cbe\u81f4\u82b1\u94bf\uff0c\u82b1\u94bf\u8272\u6cfd\u9c9c\u8273\uff0c\u4ee5\u91d1\u3001\u7c89\u4e3a\u4e3b\u8272\u8c03\uff0c\u5f62\u4f3c\u82b1\u74e3\uff0c\u8fb9\u7f18\u7ec6\u817b\u96d5\u7422\uff0c\u95ea\u70c1\u7740\u5fae\u5fae\u5149\u6cfd\u3002\u53d1\u95f4\u642d\u914d\u6d41\u82cf\u53d1\u9970\u4e0e\u6b65\u6447\uff0c\u6d41\u82cf\u7531\u4e1d\u7ebf\u4e0e\u7ec6\u5c0f\u91d1\u73e0\u4e32\u6210\uff0c\u957f\u77ed\u9519\u843d\uff0c\u968f\u7740\u52a8\u4f5c\u8f7b\u8f7b\u6447\u66f3\uff0c\u53d1\u51fa\u7ec6\u788e\u58f0\u54cd\u3002\u6b65\u6447\u4e0a\u9576\u5d4c\u7740\u84dd\u8272\u5b9d\u77f3\uff0c\u5982\u661f\u8fb0\u822c\u7480\u74a8\u3002\n\u8eab\u7740\u67d4\u8f6f\u7684\u767d\u8272\u8f7b\u7eb1\u4e91\u88f3\uff0c\u4e91\u88f3\u5e26\u6709\u957f\u957f\u6d41\u82cf\uff0c\u9762\u6599\u8f7b\u8584\u98d8\u9038\uff0c\u4eff\u4f5b\u70df\u96fe\u822c\u7f2d\u7ed5\u3002\u5916\u5c42\u62ab\u5e1b\u4ece\u53cc\u80a9\u6ed1\u843d\uff0c\u81ea\u7136\u5782\u5760\uff0c\u767d\u84dd\u91d1\u6e10\u53d8\u8272\u8fc7\u6e21\u81ea\u7136\uff0c\u4eff\u82e5\u68a6\u5e7b\u4e4b\u5883\u3002\u8170\u95f4\u675f\u7740\u6218\u56fd\u888d\u6837\u5f0f\u7684\u6e10\u53d8\u8272\u6c49\u670d\u8170\u5e26\uff0c\u8170\u5e26\u7eb9\u7406\u534e\u4e3d\uff0c\u91d1\u8272\u4e1d\u7ebf\u7ee3\u5236\u7684\u795e\u79d8\u56fe\u6848\u82e5\u9690\u82e5\u73b0\uff0c\u52fe\u52d2\u51fa\u7ea4\u7ec6\u8170\u80a2\u3002\n\u8eab\u4e0a\u914d\u9970\u7e41\u591a\u4e14\u534e\u4e3d\uff0c\u8116\u5b50\u4e0a\u6234\u7740\u4e00\u6761\u9576\u5d4c\u84dd\u8272\u5b9d\u77f3\u4e0e\u73cd\u73e0\u7684\u9879\u94fe\uff0c\u9879\u94fe\u4e2d\u592e\u7684\u5b9d\u77f3\u5448\u6c34\u6ef4\u72b6\uff0c\u6563\u53d1\u7740\u5e7d\u84dd\u5149\u8292\u3002\u624b\u8155\u4e0a\u5957\u7740\u51e0\u53ea\u91d1\u624b\u956f\uff0c\u624b\u956f\u4e0a\u523b\u6709\u7cbe\u7f8e\u7684\u9f99\u7eb9\uff0c\u4e0e\u5c71\u6d77\u7ecf\u9f99\u65cf\u516c\u4e3b\u7684\u8eab\u4efd\u76f8\u547c\u5e94\u3002\u53cc\u624b\u624b\u6307\u6234\u7740\u6212\u6307\uff0c\u6212\u6307\u9020\u578b\u72ec\u7279\uff0c\u6709\u7684\u9576\u5d4c\u7740\u5f69\u8272\u5b9d\u77f3\uff0c\u6709\u7684\u5219\u662f\u96d5\u523b\u6210\u9f99\u9996\u5f62\u72b6\u3002\n\u5bb9\u8c8c\u795e\u60c5\n\u62e5\u6709\u9ec4\u91d1\u6bd4\u4f8b\u4e94\u5b98\uff0c\u9e45\u86cb\u8138\u7ebf\u6761\u67d4\u548c\u6d41\u7545\u3002\u7cbe\u81f4\u5986\u5bb9\u4e0b\uff0c\u808c\u80a4\u767d\u7699\u7ec6\u817b\uff0c\u4f3c\u8986\u76d6\u4e86\u4e00\u5c42\u51b7\u767d\u76ae\u7c89\u5e95\u6db2\uff0c\u5448\u73b0\u51fa\u871c\u6843\u822c\u7684\u7ec6\u817b\u8d28\u611f\u3002\u4e39\u51e4\u773c\u5fae\u5fae\u4e0a\u6311\uff0c\u773c\u5c3e\u5904\u7528\u7ea2\u8272\u773c\u7ebf\u8f7b\u8f7b\u52fe\u52d2\uff0c\u773c\u795e\u9b45\u60d1\u4e14\u5b64\u50b2\uff0c\u5361\u59ff\u5170\u5927\u773c\u642d\u914d\u957f\u776b\u6bdb\uff0c\u6251\u95ea\u95f4\u4eff\u4f5b\u85cf\u7740\u65e0\u5c3d\u795e\u79d8\u3002\u9ad8\u633a\u7684\u9f3b\u6881\u4e0b\uff0c\u5634\u5507\u6d82\u62b9\u7740\u6de1\u7c89\u8272\u53e3\u7ea2\uff0c\u8272\u6cfd\u6c34\u6da6\u3002\n\u52a8\u4f5c\u59ff\u6001\n\u5728\u534a\u8eab\u7279\u5199\u753b\u9762\u4e2d\uff0c\u5fae\u5fae\u4fa7\u8eab\uff0c\u5934\u90e8\u7565\u5fae\u503e\u659c\uff0c\u773c\u795e\u76f4\u89c6\u955c\u5934\uff0c\u6d41\u9732\u51fa\u4e00\u79cd\u9ad8\u51b7\u4e0e\u758f\u79bb\u3002\u53ca\u8170\u957f\u53d1\u968f\u98ce\u98d8\u8d77\uff0c\u53d1\u4e1d\u7075\u52a8\u81ea\u7136\uff0c\u589e\u6dfb\u4e86\u51e0\u5206\u98d8\u9038\u611f\u3002\u4e00\u53ea\u624b\u8f7b\u8f7b\u62ac\u8d77\uff0c\u624b\u6307\u5fae\u66f2\uff0c\u4f3c\u5728\u8f7b\u629a\u7a7a\u6c14\u4e2d\u7684\u5c18\u57c3\uff0c\u53e6\u4e00\u53ea\u624b\u81ea\u7136\u5782\u843d\u5728\u8eab\u4fa7\uff0c\u59ff\u6001\u4f18\u96c5\u4e14\u72ec\u7279\u3002\n\u73af\u5883\n\u6574\u4f53\u573a\u666f\n\u8eab\u5904\u77f3\u7a9f\u573a\u666f\u4e4b\u4e2d\uff0c\u77f3\u7a9f\u5899\u58c1\u4e0a\u7ed8\u5236\u7740\u8272\u5f69\u6591\u6593\u7684\u58c1\u753b\uff0c\u867d\u5386\u7ecf\u5c81\u6708\u4fb5\u8680\uff0c\u4f46\u4f9d\u65e7\u80fd\u770b\u51fa\u5176\u7cbe\u7f8e\u7edd\u4f26\u3002\u58c1\u753b\u5185\u5bb9\u591a\u4e3a\u795e\u8bdd\u6545\u4e8b\u4e0e\u98de\u5929\u795e\u5973\uff0c\u7ebf\u6761\u7c97\u72b7\u800c\u6709\u529b\uff0c\u8272\u5f69\u5728\u6697\u8c03\u73af\u5883\u4e0b\u663e\u5f97\u6108\u53d1\u795e\u79d8\u3002\u77f3\u7a9f\u9876\u90e8\u5448\u62f1\u5f62\uff0c\u77f3\u5934\u7eb9\u7406\u6e05\u6670\u53ef\u89c1\uff0c\u4eff\u4f5b\u5728\u8bc9\u8bf4\u7740\u53e4\u8001\u7684\u5386\u53f2\u3002\n\u7ec6\u8282\u5e03\u7f6e\n\u77f3\u7a9f\u5185\u6446\u653e\u7740\u4e00\u4e9b\u53e4\u8001\u7684\u4f5b\u50cf\uff0c\u4f5b\u50cf\u9762\u5bb9\u6148\u60b2\uff0c\u8eab\u4e0a\u7684\u91d1\u6f06\u6709\u4e9b\u5df2\u7ecf\u8131\u843d\uff0c\u9732\u51fa\u6591\u9a73\u75d5\u8ff9\u3002\u5730\u9762\u4e0a\u6563\u843d\u7740\u4e00\u4e9b\u7834\u788e\u7684\u9676\u7247\u4e0e\u5f69\u8272\u73e0\u5b50\uff0c\u589e\u6dfb\u4e86\u51e0\u5206\u5386\u53f2\u7684\u6ca7\u6851\u611f\u3002\u5728\u4eba\u7269\u5468\u56f4\uff0c\u6709\u4e00\u4e9b\u82e5\u9690\u82e5\u73b0\u7684\u5149\u5f71\uff0c\u4f3c\u662f\u4ece\u77f3\u7a9f\u7f1d\u9699\u4e2d\u900f\u8fdb\u6765\u7684\u5149\u7ebf\uff0c\u53c8\u50cf\u662f\u795e\u79d8\u529b\u91cf\u6563\u53d1\u7684\u5149\u8292\u3002\n\u5149\u7ebf\n\u8fd0\u7528\u4f26\u52c3\u6717\u5149\uff0c\u5f3a\u70c8\u7684\u660e\u6697\u5bf9\u6bd4\u4e0e\u9ad8\u53cd\u5dee\u5851\u9020\u51fa\u7acb\u4f53\u7684\u4eba\u7269\u5f62\u8c61\u3002\u4e00\u675f\u5149\u4ece\u4eba\u7269\u4fa7\u4e0a\u65b9\u6253\u4e0b\u6765\uff0c\u7167\u4eae\u4e00\u4fa7\u8138\u988a\u3001\u5934\u53d1\u4e0e\u90e8\u5206\u670d\u9970\uff0c\u5728\u53e6\u4e00\u4fa7\u8138\u4e0a\u5f62\u6210\u4e09\u89d2\u5f62\u4eae\u533a\uff0c\u51f8\u663e\u51fa\u7acb\u4f53\u9aa8\u76f8\u3002\u6697\u8c03\u80cc\u666f\u4e0b\uff0c\u4eba\u7269\u7684\u767d\u84dd\u91d1\u6e10\u53d8\u8272\u670d\u9970\u4e0e\u767d\u7699\u808c\u80a4\u5728\u5149\u7ebf\u7167\u8000\u4e0b\u66f4\u52a0\u7a81\u51fa\uff0c\u5f62\u6210\u5f3a\u70c8\u89c6\u89c9\u51b2\u51fb\u3002\n\u540c\u65